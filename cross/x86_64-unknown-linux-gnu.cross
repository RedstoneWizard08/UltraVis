[constants]
mfam  = 'x86_64'
msys  = 'linux'
mabi  = 'gnu'
chain = mfam +'-'+ msys +'-'+ mabi
bin   = '/usr/bin'

[binaries]
c         = 'gcc'
cpp       = 'g++'
ld        = 'ld'
ar        = 'ar'
as        = 'as'
nm        = 'nm'
size      = 'size'
objdump   = 'objdump'
objcopy   = 'objcopy'
ranlib    = 'ranlib'
readelf   = 'readelf'
elfedit   = 'elfedit'
strings   = 'strings'
strip     = 'strip'
gdb       = 'gdb'
dwp       = 'dwp'
addr2line = 'addr2line'

[host_machine]
system     = msys
cpu = mfam
cpu_family = mfam
endian     = 'little'